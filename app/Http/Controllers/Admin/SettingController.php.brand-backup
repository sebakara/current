<?php

namespace App\Http\Controllers\Admin;

use App\Http\Controllers\Controller;
use App\Models\Setting;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Cache;
use Illuminate\Support\Facades\Storage;
use Illuminate\View\View;

class SettingController extends Controller
{
    public function index(): View
    {
        $definitions = $this->definitions();

        $settings = Setting::query()
            ->whereIn(
                'key',
                collect($definitions)
                    ->flatten(1)
                    ->pluck('key')
                    ->all()
            )
            ->get()
            ->keyBy('key');

        return view(
            'admin.settings.index',
            compact('definitions', 'settings')
        );
    }

    public function update(Request $request): RedirectResponse
    {
        $definitions = collect($this->definitions())
            ->flatten(1)
            ->keyBy('key');

        $rules = [];

        foreach ($definitions as $key => $definition) {
            $rules[$key] = $definition['rules'];

            if ($definition['type'] === 'image') {
                $rules["remove_{$key}"] = [
                    'nullable',
                    'boolean',
                ];
            }
        }

        $validated = $request->validate($rules);

        foreach ($definitions as $key => $definition) {
            $setting = Setting::query()
                ->where('key', $key)
                ->first();

            if ($definition['type'] === 'image') {
                $this->updateImageSetting(
                    $request,
                    $setting,
                    $definition
                );

                continue;
            }

            $value = $validated[$key] ?? null;

            if (is_string($value)) {
                $value = trim($value);
            }

            Setting::updateOrCreate(
                ['key' => $key],
                [
                    'group' => $definition['group'],
                    'value' => $value,
                    'type' => $definition['type'],
                    'is_public' => true,
                ]
            );
        }

        Cache::forget('website.public-settings');

        return redirect()
            ->route('admin.settings.index')
            ->with(
                'success',
                'Website settings updated successfully.'
            );
    }

    private function updateImageSetting(
        Request $request,
        ?Setting $setting,
        array $definition
    ): void {
        $key = $definition['key'];
        $currentPath = $setting?->value;

        if ($request->boolean("remove_{$key}")) {
            $this->deleteStoredFile($currentPath);
            $currentPath = null;
        }

        if ($request->hasFile($key)) {
            $this->deleteStoredFile($currentPath);

            $currentPath = $request
                ->file($key)
                ->store(
                    'website/settings',
                    'public'
                );
        }

        Setting::updateOrCreate(
            ['key' => $key],
            [
                'group' => $definition['group'],
                'value' => $currentPath,
                'type' => 'image',
                'is_public' => true,
            ]
        );
    }

    private function deleteStoredFile(?string $path): void
    {
        if (
            $path
            && Storage::disk('public')->exists($path)
        ) {
            Storage::disk('public')->delete($path);
        }
    }

